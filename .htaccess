# ===== VERITYA DAILY - HOSTINGER .htaccess (Apache/LiteSpeed) =====
# Preserves Vercel cleanUrls behavior on Hostinger
# Generated from forensic audit - Sep 9, 2026

# --- 1. Clean URLs: /page -> /page.html (with .html file existence check) ---
<IfModule mod_rewrite.c>
RewriteEngine On

# Only rewrite if the request is NOT a real file or directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %&#123;REQUEST_FILENAME&#125; !-d

# Rewrite clean URL to .html file if it exists
RewriteCond %&#123;DOCUMENT_ROOT&#125;/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# --- 2. Trailing slash removal (non-.html) ---
RewriteCond %&#123;REQUEST_FILENAME&#125; !-f
RewriteCond %&#123;REQUEST_FILENAME&#125; !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# --- 3. Homepage variants -> / (canonical) ---
RewriteCond %&#123;REQUEST_URI&#125; ^/index\.html$ [OR]
RewriteCond %&#123;REQUEST_URI&#125; ^/index\.php$
RewriteRule ^(.*)$ / [R=301,L]

# --- 4. .html -> clean URL 301 (SEO: prevent duplicate content on .html variants) ---
RewriteCond %&#123;THE_REQUEST&#125; \.html[\s?/]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

</IfModule>

# --- 5. 404 handling (keep Vercel-style custom 404) ---
ErrorDocument 404 /404.html

# --- 6. Security headers (match Vercel vercel.json) ---
<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# --- 7. Asset caching (match Vercel /assets/cache-control) ---
<FilesMatch "\.(css|js|png|jpg|jpeg|svg|webp|woff2?)$">
Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>
</IfModule>

# --- 8. Compression ---
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# --- 9. MIME types safety ---
AddType image/svg+xml .svg
AddType application/manifest+json .webmanifest
